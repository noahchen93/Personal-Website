{
  "name": "个人作品集 | Personal Portfolio",
  "short_name": "Portfolio",
  "description": "基于React + TypeScript + Tailwind CSS的现代化个人作品集网站，采用CLI终端风格设计",
  "version": "1.0.0",
  "manifest_version": 2,
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#3b82f6",
  "background_color": "#0a0e1a",
  "lang": "zh-CN",
  "dir": "auto",
  "categories": ["portfolio", "developer", "technology"],
