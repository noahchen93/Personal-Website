{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.6.2",
    "@hono/hono/cors": "jsr:@hono/hono@^4.6.2/cors",
    "@hono/hono/logger": "jsr:@hono/hono@^4.6.2/logger",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2.49.8"
  }
}